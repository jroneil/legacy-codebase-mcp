# Copy to .env and edit. `docker compose` reads this file automatically.
# Never commit .env: it holds a password.

# Required physical HOST directory that contains repositories at any depth.
# The base is mounted read-only at /workspace/repos; do not use a symlink path.
LEGACY_REPOSITORY_BASE=/absolute/path/containing/repositories

# Local PostgreSQL password. Choose any value; it initializes a new database volume.
POSTGRES_PASSWORD=change-me

# Optional -------------------------------------------------------------------

# Database name and role (defaults shown).
POSTGRES_DB=legacy
POSTGRES_USER=legacy

# Label recorded with every snapshot; visible as freshness metadata in REST/MCP.
ANALYZER_VERSION=grails-index-5

# Loopback-only host ports for the UI and REST/MCP endpoints.
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Host port for PostgreSQL, used only with docker-compose.dev.yml (native
# backend development). The default Compose stack does not publish PostgreSQL.
POSTGRES_PORT=54329
