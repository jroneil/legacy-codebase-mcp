# Copy to .env and edit. `docker compose` reads this file automatically.
# Never commit .env: it holds a password.

# Required. Choose any value; it initializes a new PostgreSQL volume.
POSTGRES_PASSWORD=change-me

# Optional -------------------------------------------------------------------
POSTGRES_DB=legacy
POSTGRES_USER=legacy
ANALYZER_VERSION=legacy-analyzer-1
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Used only with docker-compose.dev.yml for native backend development.
POSTGRES_PORT=54329
